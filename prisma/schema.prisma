// Prisma schema for the Budge.
//
// Money convention: every monetary column is an Int storing the currency's
// *minor unit* (cents for USD) — never a float — so arithmetic stays exact.
// See src/lib/money.ts for the shared conversion/formatting helpers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth Prisma adapter shape, plus our own password field)
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  preference             UserPreference?
  categories             Category[]
  transactions           Transaction[]
  budgets                MonthlyBudget[]
  savingsGoals           SavingsGoal[]
  recurringTransactions  RecurringTransaction[]
  passwordResetTokens    PasswordResetToken[]
  plaidItems             PlaidItem[]
  financialAccounts      FinancialAccount[]
  householdMemberships   HouseholdMember[]
  paidSharedExpenses     SharedExpense[]      @relation("SharedExpensePayer")
  sharedExpenseSplits    SharedExpenseSplit[] @relation("SharedExpenseSplitUser")

  @@index([email])
}

// Kept for future OAuth providers (Google, etc.) via the Auth.js adapter.
// Unused by the credentials-only v1 flow but required by @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// User preferences / onboarding state
// ---------------------------------------------------------------------------

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum AppLocale {
  EN
  FR
  ES
}

model UserPreference {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  currency               String    @default("USD") // ISO 4217; only USD is exercised in v1 UI
  monthlyIncomeEstimate  Int? // minor units; captured during onboarding, informational only
  onboardingCompletedAt  DateTime?
  accentColor            String    @default("#159d63") // hex; applied via a CSS custom property, see src/lib/accentColors.ts
  theme                  ThemeMode @default(SYSTEM)
  locale                 AppLocale @default(EN)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id        String          @id @default(cuid())
  // null userId = system default category, visible to every user, not editable/deletable by them
  userId    String?
  name      String
  kind      TransactionType
  color     String          @default("#6b7280")
  icon      String?
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  budgetCategories BudgetCategory[]
  recurringTransactions RecurringTransaction[]

  // Note: Postgres treats each NULL as distinct, so this constraint only
  // enforces per-user name uniqueness for real users; the fixed seed list
  // is what keeps the null-userId default rows from duplicating.
  @@unique([userId, name, kind])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Transactions (income + expenses, unified)
// ---------------------------------------------------------------------------

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int // minor units, always >= 1
  currency    String          @default("USD")
  date        DateTime
  description String?
  merchant    String?
  notes       String?
  categoryId  String?

  recurringTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which financial account this transaction belongs to. Nullable so
  // existing manually-entered transactions (no account concept in v1)
  // keep working unchanged; a transaction imported from a bank sync
  // always has one. See "Financial accounts" section below.
  accountId           String?
  // Plaid's own transaction id — unique so a repeated sync can never
  // double-import the same bank transaction (upsert-by-this-field).
  plaidTransactionId  String? @unique
  pending             Boolean @default(false) // true for a Plaid transaction not yet posted

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  account              FinancialAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type])
  @@index([categoryId])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Monthly budgets
// ---------------------------------------------------------------------------

model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String
  month     Int // 1-12
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, year, month])
  @@index([userId])
}

model BudgetCategory {
  id          String @id @default(cuid())
  budgetId    String
  categoryId  String
  amountLimit Int // minor units, planned spending limit for this category this month

  budget   MonthlyBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Savings goals
// ---------------------------------------------------------------------------

model SavingsGoal {
  id             String    @id @default(cuid())
  userId         String
  name           String
  targetAmount   Int // minor units
  currentAmount  Int       @default(0) // minor units
  targetDate     DateTime?
  notes          String?
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Recurring transactions
// ---------------------------------------------------------------------------

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model RecurringTransaction {
  id          String              @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  categoryId  String?
  description String?
  merchant    String?
  notes       String?
  frequency   RecurrenceFrequency
  startDate   DateTime
  endDate     DateTime?
  nextRunDate DateTime
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@index([nextRunDate])
}

// ---------------------------------------------------------------------------
// Financial accounts — manual net-worth entries, and/or a real read-only
// Plaid Link connection. NOTE: read-only. Nothing here ever authorizes a
// transfer, payment, or trade — see README "Connected accounts" for why
// that boundary is intentional, not a placeholder.
// ---------------------------------------------------------------------------

enum FinancialAccountSource {
  MANUAL
  PLAID
}

enum FinancialAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  INVESTMENT
  RETIREMENT
  CRYPTO
  OTHER
}

enum PlaidItemStatus {
  ACTIVE
  ERROR
  REQUIRES_RELOGIN
}

// One Plaid "Item" = one end-user login at one institution. Holds the
// long-lived access token needed to fetch that institution's data —
// never exposed to the client, only ever read inside Server Actions /
// route handlers. See src/lib/plaid.ts for the encryption-at-rest helper.
model PlaidItem {
  id                    String          @id @default(cuid())
  userId                String
  plaidItemId           String          @unique
  accessTokenCiphertext String          @db.Text
  institutionId         String?
  institutionName       String?
  status                PlaidItemStatus @default(ACTIVE)
  transactionsCursor    String? // Plaid /transactions/sync pagination cursor
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]

  @@index([userId])
}

model FinancialAccount {
  id               String                 @id @default(cuid())
  userId           String
  plaidItemId      String?
  plaidAccountId   String?                @unique
  source           FinancialAccountSource @default(MANUAL)
  name             String
  officialName     String?
  type             FinancialAccountType
  mask             String? // last 4 digits, display only
  // Minor units. For a liability (credit card, loan) this is the amount
  // owed, stored positive — net worth subtracts these, see
  // src/lib/calculations.ts#netWorth.
  currentBalance   Int
  availableBalance Int?
  currency         String                 @default("USD")
  isArchived       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem    PlaidItem?          @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  holdings     InvestmentHolding[]

  @@index([userId])
  @@index([plaidItemId])
}

// ---------------------------------------------------------------------------
// Investment holdings — read-only position tracking (manual entry, or a
// future Plaid Investments sync). There is deliberately no "trade" model:
// this app never places an order. See README.
// ---------------------------------------------------------------------------

enum AssetClass {
  EQUITY
  ETF
  MUTUAL_FUND
  CRYPTO
  BOND
  OTHER
}

model InvestmentHolding {
  id           String     @id @default(cuid())
  accountId    String
  securityName String
  ticker       String?
  assetClass   AssetClass @default(OTHER)
  // Share/coin count. Decimal (exact, arbitrary precision), not a float —
  // crypto quantities routinely need 8+ decimal places.
  quantity     Decimal    @db.Decimal(24, 8)
  costBasis    Int? // minor units, optional (may be unknown for older holdings)
  currentValue Int // minor units — the authoritative figure used in net worth
  asOfDate     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Household shared-expense ledger — tracks who-owes-whom for expenses paid
// on a group's behalf. Deliberately a ledger only: no balance here is ever
// money the app holds or can move. "Settle up" is a manual acknowledgement
// that money changed hands elsewhere (cash, Venmo, etc.), not a transfer.
// ---------------------------------------------------------------------------

enum HouseholdRole {
  OWNER
  MEMBER
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members  HouseholdMember[]
  expenses SharedExpense[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model SharedExpense {
  id           String   @id @default(cuid())
  householdId  String
  paidByUserId String
  amount       Int // minor units, total expense amount
  description  String
  date         DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  household Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy    User                 @relation("SharedExpensePayer", fields: [paidByUserId], references: [id], onDelete: Cascade)
  splits    SharedExpenseSplit[]

  @@index([householdId])
  @@index([paidByUserId])
}

// Each member's share of one SharedExpense. Shares should sum to the
// parent expense's amount — enforced in application logic
// (src/lib/validation/household.ts), not the database.
model SharedExpenseSplit {
  id              String @id @default(cuid())
  sharedExpenseId String
  userId          String
  shareAmount     Int // minor units

  sharedExpense SharedExpense @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  user          User          @relation("SharedExpenseSplitUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedExpenseId, userId])
  @@index([userId])
}
