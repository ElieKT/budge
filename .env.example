# ---------------------------------------------------------------------------
# Copy to .env for local development (`cp .env.example .env`) and fill in.
# In production (Vercel, etc.), set these as encrypted project environment
# variables instead of committing a .env file. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Any managed Postgres works (Neon, Supabase,
# Railway, RDS, Vercel Postgres). Must include sslmode=require in production.
# Example: postgresql://user:password@host:5432/budget_app?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/budget_app"

# Auth.js (NextAuth) requires a random 32+ byte secret used to sign/encrypt
# session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL of the deployed app. Used for building absolute links (e.g. in
# password-reset messages) and for Auth.js's own callback resolution.
NEXTAUTH_URL="http://localhost:3000"

# Shared secret required in the `Authorization: Bearer <value>` header when
# calling /api/cron/recurring. Set this in your scheduler (Vercel Cron,
# GitHub Actions, cron-job.org, etc.) — see README "Recurring transactions".
CRON_SECRET="replace-with-a-long-random-string"

# --- Optional: transactional email --------------------------------------
# Not required to run the app. Without it, password-reset links are logged
# to the server console instead of emailed (development-only fallback —
# see src/lib/email.ts). Set these to enable real delivery via Resend
# (https://resend.com); swap src/lib/email.ts for another provider if
# preferred.
RESEND_API_KEY=""
EMAIL_FROM="Budge <onboarding@resend.dev>"
